{
  "expo": {
    "name": "Passerelle",
    "slug": "passerelle",
    "owner": "siquanes-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "passerelle",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.passerelle.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#070912",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.passerelle.mobile",
      "googleServicesFile": "./google-services.json",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-calendar",
        {
          "calendarPermission": "Passerelle a besoin de ton calendrier pour y ajouter les tâches de la famille.",
          "writeOnlyAccess": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#070912",
          "image": "./assets/splash-icon.png",
          "imageWidth": 220
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#45A0FF"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Passerelle a besoin de tes photos pour joindre une image à une recette, un document ou une dépense.",
          "cameraPermission": "Passerelle a besoin de l'appareil photo pour photographier une recette, un document ou un ticket.",
          "microphonePermission": false
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Resume",
              "label": "Passerelle · Aujourd'hui",
              "description": "Prochaine tâche, dîner du soir et budget du mois",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widgets/resume.png"
            },
            {
              "name": "Taches",
              "label": "Passerelle · Tâches du jour",
              "description": "Les tâches d'aujourd'hui avec leur heure",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widgets/taches.png"
            },
            {
              "name": "Menu",
              "label": "Passerelle · Menu",
              "description": "Le dîner de ce soir et des prochains jours",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widgets/menu.png"
            },
            {
              "name": "Courses",
              "label": "Passerelle · Courses",
              "description": "Ce qu'il reste à acheter",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 3,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widgets/courses.png"
            },
            {
              "name": "AjoutTache",
              "label": "Passerelle · Ajouter une tâche",
              "description": "Un bouton pour ajouter une tâche en un geste",
              "minWidth": "180dp",
              "minHeight": "40dp",
              "targetCellWidth": 3,
              "targetCellHeight": 1,
              "resizeMode": "horizontal",
              "updatePeriodMillis": 0,
              "previewImage": "./assets/widgets/ajout.png"
            },
            {
              "name": "Notes",
              "label": "Passerelle · Notes",
              "description": "Les dernières notes, et un + pour en écrire une",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widgets/notes.png"
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": "10",
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
