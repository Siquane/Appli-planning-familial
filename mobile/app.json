{
  "expo": {
    "name": "Passerelle",
    "slug": "passerelle",
    "owner": "siquanes-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "passerelle",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.passerelle.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#121316",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.passerelle.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-calendar",
        {
          "calendarPermission": "Passerelle a besoin d'accéder à votre calendrier pour synchroniser vos tâches.",
          "writeOnlyAccess": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#121316",
          "image": "./assets/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-notifications",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Passerelle a besoin d'accéder à vos photos pour joindre une image à une recette ou à un document.",
          "cameraPermission": "Passerelle a besoin de l'appareil photo pour photographier une recette ou un document."
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Resume",
              "label": "Passerelle · Aujourd'hui",
              "description": "Prochaine tâche, dîner du soir et budget du mois",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Taches",
              "label": "Passerelle · Tâches du jour",
              "description": "Les tâches d'aujourd'hui avec leur heure",
              "minWidth": "250dp",
              "minHeight": "180dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Menu",
              "label": "Passerelle · Menu",
              "description": "Le dîner de ce soir et des prochains jours",
              "minWidth": "250dp",
              "minHeight": "140dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Courses",
              "label": "Passerelle · Courses",
              "description": "Ce qu'il reste à acheter",
              "minWidth": "180dp",
              "minHeight": "180dp",
              "targetCellWidth": 3,
              "targetCellHeight": 3,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": "2",
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
