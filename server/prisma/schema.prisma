// Rythmo API data model. Postgres (see DATABASE_URL) — a managed instance
// like Neon works well for a free-tier deploy (see app/server/README-deploy.md).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String               @id @default(cuid())
  email                String               @unique
  passwordHash         String
  name                 String
  initials             String
  createdAt            DateTime             @default(now())
  // Each pack is active while its date is in the future ("Les 2" sets both).
  // Set by hand for now (npm run premium), later by the store purchase.
  budgetUntil          DateTime?
  // Free trial of Budget+: started once per account, lasts BUDGET_TRIAL_DAYS (lib/plan.ts).
  budgetTrialStartedAt DateTime?
  // Horaires de travail de CE compte (0 = lundi … 6 = dimanche ; vide = aucun) :
  // « Replanifier » ne propose rien pendant ces heures.
  workDays             Int[]                @default([])
  workStart            String               @default("09:00")
  workEnd              String               @default("17:30")
  // Family sharing. A family is the data of its creator (the « owner »); other
  // accounts join it with a code (see lib/family.ts). null = this account is
  // its own family's owner. Roles of a joiner: "full" shares everything,
  // including budget and documents; "planning" shares the planning only and
  // keeps its own budget and documents. Packs and trial always belong to the owner.
  familyOwnerId        String?
  familyOwner          User?                @relation("FamilyAccounts", fields: [familyOwnerId], references: [id], onDelete: SetNull)
  familyAccounts       User[]               @relation("FamilyAccounts")
  familyRole           String               @default("owner")
  // Compte « enfant » (moins de 15 ans) créé par un parent pour ce membre de la
  // famille : connexion par code, pas d'e-mail ni de mot de passe utilisables.
  childMemberId        String?              @unique
  childMember          FamilyMember?        @relation("ChildAccount", fields: [childMemberId], references: [id], onDelete: Cascade)
  childLoginCodes      ChildLoginCode[]
  pocketMoneyRule      PocketMoneyRule?     @relation("PocketMoneyRule")
  pocketMoneyCredits   PocketMoneyCredit[]  @relation("PocketMoneyCredits")
  pocketMoneyAdvances  PocketMoneyAdvance[] @relation("PocketMoneyAdvances")
  familyInvite         FamilyInvite?
  // One-time message (JSON) shown at the next opening after the family changed hands; see lib/familyHandover.ts.
  familyNotice         String?
  // Notification sur le téléphone quand un autre compte de la famille modifie
  // le planning, les repas, les courses ou les recettes (lib/familyAlerts.ts).
  familyAlerts         Boolean              @default(true)
  pushTokens           PushToken[]
  mealsUntil           DateTime?
  // Explicit consent to store members' diets, allergies and foods to limit
  // (health data / may reveal religion, RGPD art. 9). Null = not given.
  foodHealthConsentAt  DateTime?

  members             FamilyMember[]
  tasks               Task[]
  recipes             Recipe[]
  meals               Meal[]
  documents           Document[]
  expenses            Expense[]
  shoppingItems       ShoppingItem[]
  expenseCategories   ExpenseCategory[]
  categoryBudgets     CategoryBudget[]
  recurringExpenses   RecurringExpense[]
  notifications       Notification[]
  constraints         Constraints?
  shareLink           ShareLink?
  sharedWith          SharedPerson[]
  passwordResetCodes  PasswordResetCode[]
  calendarConnections CalendarConnection[]
  refreshTokens       RefreshToken[]
  mealGenerations     MealGeneration[]
  savingsGoals        SavingsGoal[]
  importRules         ImportRule[]
  capAlerts           CapAlert[]
  driftAlerts         DriftAlert[]
  notes               Note[]               @relation("NoteSpace")
  authoredNotes       Note[]               @relation("NoteAuthor")
  starCompletions     StarCompletion[]
  rewards             Reward[]
  rewardRedemptions   RewardRedemption[]
  rewardRequests      RewardRequest[]
  learners            Learner[]
  aiUsages            AiUsage[]
  splitGroups         SplitGroup[]
}

// Code à 6 chiffres envoyé par e-mail pour se connecter sans mot de passe (appli
// Cervelle). Lié à l'adresse et non au compte : il sert aussi à créer le compte.
model EmailLoginCode {
  id        String   @id @default(cuid())
  // Adresse en minuscules.
  email     String
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model PasswordResetCode {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// tint: 'accent' | 'neutral' | 'accent2' — matches the Nocturne avatar tint roles
model FamilyMember {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  initials     String
  tint         String    @default("neutral")
  age          Int?
  birthday     DateTime?
  order        Int       @default(0)
  // Lien public de son planning (« /share/m/<jeton> »), créé à la demande.
  shareToken   String?   @unique
  childAccount User?     @relation("ChildAccount")

  // Food preferences, used to tailor generated menus. Sent to Claude
  // without the member's name (see services/mealPlanner.ts).
  favoriteFoods String   @default("")
  dislikedFoods String   @default("")
  appetite      String? // "petit" | "moyen" | "gros"
  canteenDays   Int[]    @default([]) // 0 = lundi … 4 = vendredi: lunch eaten outside
  foodNotes     String   @default("")
  // Sensitive (health / may reveal religion): only stored while the account
  // has given explicit consent (User.foodHealthConsentAt), cleared when it's withdrawn.
  diets         String[] @default([])
  allergies     String   @default("")
  foodsToLimit  String   @default("")

  tasks             TaskMember[]
  recipes           RecipeMember[]
  documents         Document[]
  expenses          Expense[]
  recurringExpenses RecurringExpense[]
  starCompletions   StarCompletion[]
  rewardRedemptions RewardRedemption[]
  rewardRequests    RewardRequest[]
  learners          Learner[]
  splitParticipants SplitParticipant[]

  @@index([userId])
}

// priority: 'high' | 'medium' | 'low'
model Task {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  category         String
  date             DateTime
  weekday          Int
  time             String
  duration         Int      @default(30)
  priority         String   @default("medium")
  deadlineWeekday  Int?
  recurring        Boolean  @default(false)
  reminder         Boolean  @default(false)
  flexible         Boolean  @default(false)
  synced           Boolean  @default(false)
  notes            String   @default("")
  // Tâches créées ensemble sur plusieurs jours (une ligne par jour) : même
  // seriesId, pour les modifier ou les supprimer ensemble. null = tâche seule.
  seriesId         String?
  // Étoiles gagnées par un enfant (moins de 15 ans) quand la tâche est faite.
  stars            Int      @default(1)
  // Apparaît dans le récap du soir et du matin (décochable par tâche).
  inDigest         Boolean  @default(true)
  // Rendez-vous : une date précise « AAAA-MM-JJ » (null = tâche de la semaine
  // type, affichée chaque semaine). weekday est alors le jour de cette date.
  appointmentDate  String?
  location         String   @default("")
  // Rappel d'un rendez-vous : "hour" (1 h avant), "eve" (la veille à 20 h) ou null.
  remind           String?
  externalEventId  String?
  externalProvider String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  members         TaskMember[]
  starCompletions StarCompletion[]
  doneDays        TaskDone[]

  @@index([userId, seriesId])
}

model TaskMember {
  taskId   String
  task     Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  memberId String
  member   FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([taskId, memberId])
}

// ingredients/steps: ordered lists, one entry per item/step
model Recipe {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  ingredients String[]
  steps       String[]
  notes       String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members   RecipeMember[]
  meals     Meal[]
  documents Document[]

  @@index([userId])
}

model RecipeMember {
  recipeId String
  recipe   Recipe       @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  memberId String
  member   FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([recipeId, memberId])
}

// type: 'petit-déjeuner' | 'déjeuner' | 'goûter' | 'dîner'
// One slot per weekday+type (upserted), same weekly-template model as Task
// (weekday, not an absolute date — see lib/dates.ts).
model Meal {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Lundi de la semaine du repas, « AAAA-MM-JJ » : chaque semaine a son menu.
  week        String
  weekday     Int
  type        String
  title       String   @default("")
  recipeId    String?
  recipe      Recipe?  @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  notes       String   @default("")
  // Shopping list of a generated dish that isn't a family recipe (a recipe
  // keeps its own ingredients). Cleared when the dish is renamed by hand.
  ingredients String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, week, weekday, type])
}

// A file kept in object storage (Cloudflare R2 or S3 — see lib/storage.ts).
// The database only holds the object key, never the file itself.
// recipeId set   -> attachment of that recipe (photo or PDF)
// recipeId null  -> entry of the family document library
// category: 'santé' | 'assurance' | 'école' | 'administratif' | 'maison' | 'autre'
// status: 'pending' until the app confirms the upload, then 'ready'
model Document {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  category  String        @default("autre")
  memberId  String?
  member    FamilyMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  recipeId  String?
  recipe    Recipe?       @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  fileKey   String        @unique
  fileName  String
  mimeType  String
  size      Int
  status    String        @default("pending")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([userId, recipeId])
}

// Manually entered household expense. amountCents avoids float rounding;
// date is a calendar day (no time, no timezone).
// category: one of the fixed keys listed in lib/expenseCategories.ts
// ('courses', 'logement', 'énergie', … 'divers'), or the id of one of
// the family's ExpenseCategory rows (see lib/expenseCategories.ts).
// recurringId: set when the row was generated from a RecurringExpense.
model Expense {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String
  amountCents Int
  category    String            @default("divers")
  date        DateTime          @db.Date
  memberId    String?
  member      FamilyMember?     @relation(fields: [memberId], references: [id], onDelete: SetNull)
  recurringId String?
  recurring   RecurringExpense? @relation(fields: [recurringId], references: [id], onDelete: SetNull)
  // Set on a payment into a savings goal (category 'épargne').
  goalId      String?
  goal        SavingsGoal?      @relation(fields: [goalId], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([userId, date])
}

// Category created by the family, on top of the fixed list. Deleting one moves
// its expenses and recurring expenses to 'divers' (its budget is dropped).
model ExpenseCategory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// The code an owner gives to someone joining the family. One live code per
// family; it expires, and a new one replaces it.
model FamilyInvite {
  id        String   @id @default(cuid())
  ownerId   String   @unique
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  code      String   @unique
  /**
   * Role given to those who join with it: "full" | "planning".
   */
  role      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// What the family decided for a merchant when importing a bank statement
// (« CARREFOUR CITY » → courses), reused for the next imports. `key` is the
// merchant name without card numbers or dates (lib/statementParser.ts labelKey);
// no amount, no account number and no raw bank text is kept.
model ImportRule {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  category  String
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
}

// Monthly spending cap for one category, the same every month.
model CategoryBudget {
  id         String @id @default(cuid())
  userId     String
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   String
  limitCents Int

  @@unique([userId, category])
}

// Template copied into an Expense once per month, on dayOfMonth (clamped to
// the month's last day), from startMonth on, when that month's budget is read.
model RecurringExpense {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String
  amountCents Int
  category    String        @default("divers")
  memberId    String?
  member      FamilyMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  dayOfMonth  Int
  startMonth  String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  expenses Expense[]
  runs     RecurringRun[]

  @@index([userId])
}

// Marks a month as already generated for a RecurringExpense, so deleting that
// month's copy doesn't bring it back on the next read.
model RecurringRun {
  recurringId String
  recurring   RecurringExpense @relation(fields: [recurringId], references: [id], onDelete: Cascade)
  month       String

  @@id([recurringId, month])
}

// Shopping list shared by the family. fromMenu: added by « Générer depuis le
// menu » (ingredients of the week's recipes) rather than typed by hand.
model ShoppingItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  checked   Boolean  @default(false)
  fromMenu  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Constraints {
  id         String @id @default(cuid())
  userId     String @unique
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sleepStart String @default("20:00")
  sleepEnd   String @default("07:00")
  lunchStart String @default("12:00")
  lunchEnd   String @default("13:30")
  dndStart   String @default("20:00")
  dndEnd     String @default("22:00")
}

// group derived from createdAt at read time ('today' | 'week')
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  unread    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([userId])
}

model ShareLink {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  token  String @unique
}

model SharedPerson {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name   String
  role   String @default("Invité")

  @@index([userId])
}

// provider: 'google' | 'outlook' | 'apple'
// Apple has no server-held tokens (device EventKit sync is client-side) — a
// connection row is still written with provider='apple' so /calendar/status
// reports it consistently, but accessToken/refreshToken stay null for it.
model CalendarConnection {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String
  email        String?
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())

  @@unique([userId, provider])
}

// One call to the menu generator, for quotas. kind: 'week' (a whole
// proposal) | 'reroll' (« autre idée » for one slot).
model MealGeneration {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Premium: a savings target (vacances, Noël…). Progress is the sum of the
// expenses linked to it.
model SavingsGoal {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  targetCents Int
  deadline    DateTime? @db.Date
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  expenses Expense[]

  @@index([userId])
}

// Premium: a cap alert already raised, so each level (80 / 100 %) fires once
// per category and month.
model CapAlert {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String
  month     String
  level     Int
  createdAt DateTime @default(now())

  @@unique([userId, category, month, level])
}

// Jeton Expo d'un téléphone connecté (un compte peut en avoir plusieurs).
model PushToken {
  token     String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Étoiles : une tâche faite par un enfant, une fois par semaine (week = lundi,
// « AAAA-MM-JJ », date locale du téléphone). Le titre et les étoiles sont
// recopiés : supprimer la tâche ne retire pas les étoiles gagnées.
model StarCompletion {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId    String?
  task      Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)
  memberId  String
  member    FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  week      String
  title     String
  stars     Int
  createdAt DateTime     @default(now())

  @@unique([taskId, memberId, week])
  @@index([userId, memberId])
}

// Récompense définie par un adulte (ex. « Sortie cinéma », 20 étoiles).
model Reward {
  id          String             @id @default(cuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  cost        Int
  createdAt   DateTime           @default(now())
  redemptions RewardRedemption[]
  requests    RewardRequest[]

  @@index([userId])
}

// Récompense échangée : les étoiles sont dépensées (titre et prix recopiés).
model RewardRedemption {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberId  String
  member    FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  rewardId  String?
  reward    Reward?      @relation(fields: [rewardId], references: [id], onDelete: SetNull)
  title     String
  cost      Int
  createdAt DateTime     @default(now())

  @@index([userId, memberId])
}

// Dérive signalée (Budget+) : une fois par catégorie et par mois (lib/drifts.ts).
model DriftAlert {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String
  month     String
  createdAt DateTime @default(now())

  @@unique([userId, category, month])
}

// ─── Cervelle (révisions) ────────────────────────────────────────────────
// A separate app (Cervelle) uses this server and the family's accounts.
// Parents sign in with their Passerelle account; each child gets a Learner
// profile and signs in on their own phone with a one-time code (LearnerCode)
// that gives that phone a device token (LearnerDevice). See routes/cervelle.ts.

model Learner {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberId     String?
  member       FamilyMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  name         String
  // "primaire" | "college" | "lycee" | "superieur" | "adulte"
  level        String
  // School year as the family writes it (« CM1 », « 4e », « Terminale »…), or "".
  grade        String        @default("")
  color        String        @default("violet")
  // Game: coins to spend in the shop, xp grows the mascot, streak = study days in a row.
  coins        Int           @default(0)
  xp           Int           @default(0)
  streak       Int           @default(0)
  bestStreak   Int           @default(0)
  // Calendar day (Europe/Paris, « 2026-11-14 ») of the last study session.
  lastStudyDay String?
  // Day on which the daily missions' chest was opened.
  chestDay     String?
  owned        String[]      @default([])
  equipped     String[]      @default([])
  /// Up to 3 saved outfits (lists of item ids), see src/lib/cervelle/shop.ts.
  outfits      Json          @default("[]")
  // Timer lengths the child chose (minutes); null = the default for their level.
  focusMinutes Int?
  breakMinutes Int?
  // Result of « Quel élève es-tu ? »: { profile, scores, methods[] }.
  studyProfile Json?
  // Code another child types to ask to be friends (6 characters), made on first use.
  friendCode   String?       @unique
  createdAt    DateTime      @default(now())

  codes          LearnerCode[]
  devices        LearnerDevice[]
  revisions      Revision[]
  cardDraws      CardDraw[]
  teachQuizzes   TeachQuiz[]
  attempts       Attempt[]
  sessions       StudySession[]
  examReviews    ExamReview[]
  homework       HomeworkHelp[]
  brevetSubjects BrevetSubject[]
  events         StudyEvent[]
  todos          TodoItem[]
  habits         Habit[]
  journal        JournalEntry[]
  friendsOut     Friendship[]    @relation("FriendFrom")
  friendsIn      Friendship[]    @relation("FriendTo")
  cheersSent     Cheer[]         @relation("CheerFrom")
  cheersReceived Cheer[]         @relation("CheerTo")
  challengesOut  Challenge[]     @relation("ChallengeFrom")
  challengesIn   Challenge[]     @relation("ChallengeTo")
  badges         LearnerBadge[]
  starEvents     StarEvent[]
  goals          LearnerGoal[]
  duelsOut       QuizDuel[]      @relation("DuelFrom")
  duelsIn        QuizDuel[]      @relation("DuelTo")

  @@index([userId])
}

/// A badge a child earned (see src/lib/cervelle/badges.ts for the keys).
/// Stored once, so it pays its coins once; seenAt clears the red dot.
model LearnerBadge {
  id        String    @id @default(cuid())
  learnerId String
  learner   Learner   @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  key       String
  coins     Int       @default(0)
  earnedAt  DateTime  @default(now())
  seenAt    DateTime?

  @@unique([learnerId, key])
}

model LearnerCode {
  id        String   @id @default(cuid())
  learnerId String
  learner   Learner  @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  codeHash  String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([learnerId])
}

model LearnerDevice {
  id         String   @id @default(cuid())
  learnerId  String
  learner    Learner  @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  name       String   @default("")
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  // Expo push token of this phone (« ExponentPushToken[…] »), for « Tes fiches sont prêtes ».
  pushToken  String?  @unique
  // The child can turn the « fiches prêtes » notification off on this phone.
  readyAlert Boolean  @default(true)

  @@index([learnerId])
}

model Revision {
  id                 String    @id @default(cuid())
  learnerId          String
  learner            Learner   @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  title              String    @default("")
  subject            String    @default("")
  // Illustration key chosen by Claude among a fixed list (see lib/cervelle/icons.ts).
  icon               String    @default("livre")
  examDate           DateTime?
  // "processing" | "ready" | "failed"
  status             String    @default("processing")
  /// First time the « boss de fin de chapitre » was beaten on this revision.
  bossBeatenAt       DateTime?
  error              String?
  // "parent" | "enfant"
  createdBy          String    @default("parent")
  summary            String    @default("")
  // Revision sheets: [{ notionId, title, essentiel, points[], vocabulaire[{terme, definition}], exemple, retenir }]
  sheets             Json      @default("[]")
  photoKeys          String[]  @default([])
  photoCount         Int       @default(0)
  sheetsReadAt       DateTime?
  // Chapter of the official programme (lib/cervelle/programme.ts), when the class has one.
  programmeChapterId String?
  // Best scores in percent.
  quizBest           Int?
  examBest           Int?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  notions     Notion[]
  teachQuizzes TeachQuiz[]
  questions   Question[]
  sessions    StudySession[]
  examReviews ExamReview[]

  @@index([learnerId, createdAt])
}

model Notion {
  id             String    @id @default(cuid())
  revisionId     String
  revision       Revision  @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  parentId       String?
  parent         Notion?   @relation("NotionTree", fields: [parentId], references: [id], onDelete: Cascade)
  children       Notion[]  @relation("NotionTree")
  title          String
  order          Int       @default(0)
  // "new" (en cours) | "review" (à revoir) | "mastered" (maîtrisé)
  mastery        String    @default("new")
  // Added by Cervelle because the programme expects it and the photographed course left it out.
  fromProgramme  Boolean   @default(false)
  // Correct answers in a row, drives the spaced-review interval.
  streak         Int       @default(0)
  nextReviewAt   DateTime?
  lastAnsweredAt DateTime?
  /// First time it was « Maîtrisé » (never cleared): reveals a spot on the treasure map.
  masteredAt     DateTime?

  questions Question[]

  @@index([revisionId])
}

model Question {
  id          String   @id @default(cuid())
  revisionId  String
  revision    Revision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  notionId    String
  notion      Notion   @relation(fields: [notionId], references: [id], onDelete: Cascade)
  // "qcm" | "vrai_faux" | "carte" | "courte" | "trous" | "ordre"
  type        String
  prompt      String
  choices     String[] @default([])
  // qcm: index of the right choice; vrai_faux: "vrai" | "faux"; others: the expected answer.
  answer      String
  acceptable  String[] @default([])
  items       String[] @default([])
  explanation String   @default("")
  order       Int      @default(0)

  attempts Attempt[]

  @@index([revisionId])
}

model Attempt {
  id         String    @id @default(cuid())
  learnerId  String
  learner    Learner   @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  // Null once the question is gone (a revision prepared again with more
  // pages): the answer still counts for the child's effort and badges.
  questionId String?
  question   Question? @relation(fields: [questionId], references: [id], onDelete: SetNull)
  correct    Boolean
  answer     String    @default("")
  mode       String
  createdAt  DateTime  @default(now())

  @@index([learnerId, createdAt])
}

model StudySession {
  id         String    @id @default(cuid())
  learnerId  String
  learner    Learner   @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  revisionId String?
  revision   Revision? @relation(fields: [revisionId], references: [id], onDelete: SetNull)
  // "fiches" | "qcm" | "cartes" | "interro" | "a_revoir" | "minuteur"
  mode       String
  // What a timer session was for (« Exo 3 physique »), when it isn't a revision.
  label      String    @default("")
  seconds    Int       @default(0)
  correct    Int       @default(0)
  total      Int       @default(0)
  coins      Int       @default(0)
  day        String
  createdAt  DateTime  @default(now())

  @@index([learnerId, createdAt])
  @@index([learnerId, day])
}

model ExamReview {
  id         String    @id @default(cuid())
  learnerId  String
  learner    Learner   @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  revisionId String?
  revision   Revision? @relation(fields: [revisionId], references: [id], onDelete: SetNull)
  status     String    @default("processing")
  error      String?
  // { note, resume, points_forts[], erreurs[{question, reponse_eleve, correction, explication, notion}], conseils[] }
  analysis   Json?
  photoKeys  String[]  @default([])
  createdAt  DateTime  @default(now())

  @@index([learnerId, createdAt])
}

// Every Claude call made for Cervelle, to cap daily use per family.
model AiUsage {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // "revision" | "exam" | "assistant" | "grading" | "timetable"
  kind             String
  // Cervelle: the child it was for, and what the call really used (filled
  // once the call ends; 0 for older rows and for other features).
  learnerId        String?
  model            String   @default("")
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  // Millionths of a dollar.
  costMicros       Int      @default(0)
  createdAt        DateTime @default(now())

  @@index([userId, kind, createdAt])
}

// ─── Cervelle : s'organiser (agenda, tâches, habitudes, journal) ─────────

// A slot of the child's agenda: every week on `weekday` (timetable), or once on `day`.
model StudyEvent {
  id                 String   @id @default(cuid())
  learnerId          String
  learner            Learner  @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  title              String
  // "cours" | "interro" | "devoir" | "revision" | "activite"
  kind               String   @default("cours")
  // 0 = lundi … 6 = dimanche (same as Passerelle's tasks).
  weekday            Int?
  day                String?
  start              String
  end                String
  room               String   @default("")
  // "parent" | "enfant"
  createdBy          String   @default("enfant")
  // "cervelle", or "passerelle" when it was brought in from the family planning.
  source             String   @default("cervelle")
  // The Passerelle task this slot is synchronised with, when the parent asked for it.
  passerelleTaskId   String?
  // Category of the Passerelle task (« École », « Maison »…) for slots brought in from it.
  passerelleCategory String?
  createdAt          DateTime @default(now())

  @@index([learnerId])
}

model TodoItem {
  id        String    @id @default(cuid())
  learnerId String
  learner   Learner   @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  title     String
  urgent    Boolean   @default(false)
  important Boolean   @default(true)
  dueDay    String?
  doneAt    DateTime?
  // What ticking it gave, taken back if it's unticked.
  coins     Int       @default(0)
  xp        Int       @default(0)
  createdBy String    @default("enfant")
  createdAt DateTime  @default(now())

  @@index([learnerId, createdAt])
}

model Habit {
  id         String    @id @default(cuid())
  learnerId  String
  learner    Learner   @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  title      String
  emoji      String    @default("⭐")
  color      String    @default("ciel")
  // Days it's planned (0 = lundi … 6 = dimanche).
  days       Int[]     @default([0, 1, 2, 3, 4, 5, 6])
  order      Int       @default(0)
  archivedAt DateTime?
  createdBy  String    @default("enfant")
  createdAt  DateTime  @default(now())

  checks HabitCheck[]

  @@index([learnerId])
}

model HabitCheck {
  id        String   @id @default(cuid())
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  day       String
  coins     Int      @default(0)
  xp        Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([habitId, day])
}

model JournalEntry {
  id        String   @id @default(cuid())
  learnerId String
  learner   Learner  @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  day       String
  // 1 (pas bien) … 5 (super)
  mood      Int
  learned   String   @default("")
  proud     String   @default("")
  hard      String   @default("")
  updatedAt DateTime @updatedAt

  @@unique([learnerId, day])
}

// ─── Cervelle : amis (validés par un parent de chaque côté) ──────────────

model Friendship {
  id           String   @id @default(cuid())
  fromId       String
  from         Learner  @relation("FriendFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId         String
  to           Learner  @relation("FriendTo", fields: [toId], references: [id], onDelete: Cascade)
  // A parent of each child must say yes before they see each other.
  fromApproved Boolean  @default(false)
  toApproved   Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@unique([fromId, toId])
  @@index([toId])
}

// A ready-made encouragement (no free text between children).
model Cheer {
  id        String    @id @default(cuid())
  fromId    String
  from      Learner   @relation("CheerFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId      String
  to        Learner   @relation("CheerTo", fields: [toId], references: [id], onDelete: Cascade)
  kind      String
  seenAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([toId, createdAt])
  @@index([fromId, createdAt])
}

// « Qui travaille le plus cette semaine ? » between two friends.
/// A goal a parent sets: « jours » (days of revision in a week) or
/// « etoiles » (stars of the month's path), with a real family reward. It
/// starts again every week / month; `wins` lists the periods reached.
model LearnerGoal {
  id        String   @id @default(cuid())
  learnerId String
  learner   Learner  @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  kind      String
  target    Int
  reward    String
  wins      String[] @default([])
  createdAt DateTime @default(now())

  @@index([learnerId])
}

/// « Chemin d'étoiles »: things that happen once — a chest opened that day
/// (key « chest:2026-11-18 », its stars), a step's reward paid (key
/// « step:2026-11:14 », its coins and item). Unique key: paid once.
model StarEvent {
  id        String   @id @default(cuid())
  learnerId String
  learner   Learner  @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  key       String
  day       String
  coins     Int      @default(0)
  item      String?
  /// Bonus stars for that month's path (advent calendar), counted on `day`.
  stars     Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([learnerId, key])
}

/// One card drawn for the album (src/lib/cervelle/cards.ts): the n-th card
/// earned, which card it was, and the coins when it was already in the album.
model CardDraw {
  id        String    @id @default(cuid())
  learnerId String
  learner   Learner   @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  n         Int
  cardId    String
  duplicate Boolean   @default(false)
  coins     Int       @default(0)
  createdAt DateTime  @default(now())

  @@unique([learnerId, n])
}

/// « Apprends-le à papa/maman » : a child sends 5 questions of a revision to the
/// family; a parent answers them in Passerelle, the child sees the answers and
/// gets stars for having taught.
model TeachQuiz {
  id              String    @id @default(cuid())
  learnerId       String
  learner         Learner   @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  revisionId      String
  revision        Revision  @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  questionIds     String[]
  /// [{ questionId, answer, correct }] once answered.
  answers         Json?
  answeredById    String?
  answeredByName  String?
  answeredAt      DateTime?
  /// The child saw the parent's answers.
  seenAt          DateTime?
  createdAt       DateTime  @default(now())

  @@index([learnerId, createdAt])
}

/// A quiz duel between two friends: the same 10 questions (QCM, vrai/faux)
/// taken from the challenger's course; the best score wins coins.
model QuizDuel {
  id            String    @id @default(cuid())
  fromId        String
  from          Learner   @relation("DuelFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId          String
  to            Learner   @relation("DuelTo", fields: [toId], references: [id], onDelete: Cascade)
  revisionTitle String
  questionIds   String[]
  fromScore     Int?
  toScore       Int?
  // "open" | "done" | "expired"
  status        String    @default("open")
  winnerId      String?
  /// Who got the progress bonus (better than in their own previous duel).
  progressIds   String[]  @default([])
  createdAt     DateTime  @default(now())
  endedAt       DateTime?

  @@index([fromId, createdAt])
  @@index([toId, createdAt])
}

model Challenge {
  id          String   @id @default(cuid())
  fromId      String
  from        Learner  @relation("ChallengeFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId        String
  to          Learner  @relation("ChallengeTo", fields: [toId], references: [id], onDelete: Cascade)
  // Monday of the week (« 2026-11-16 »).
  week        String
  // "pending" | "active" | "declined" | "done"
  status      String   @default("pending")
  winnerId    String?
  fromMinutes Int?
  toMinutes   Int?
  createdAt   DateTime @default(now())

  @@index([fromId, week])
  @@index([toId, week])
}

// Une tâche cochée « faite » un jour donné (« AAAA-MM-JJ »). Une tâche
// récurrente se coche chaque semaine : une ligne par jour.
model TaskDone {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  day       String
  createdAt DateTime @default(now())

  @@unique([taskId, day])
}

// Notes. Une note « Famille » vit dans l'espace de la famille (userId = id de
// la famille) et tous ses comptes la voient ; une note « Perso » vit chez son
// auteur (userId = son compte) et lui seul la voit. Quitter la famille ou
// supprimer son compte n'emporte donc que ses notes perso.
model Note {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("NoteSpace", fields: [userId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  shared    Boolean  @default(true)
  title     String   @default("")
  body      String   @default("")
  color     String   @default("default")
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
}

// Code à usage unique qu'un parent donne à son enfant pour connecter Passerelle
// sur son téléphone (valable CHILD_CODE_TTL_HOURS). Seule l'empreinte est gardée.
model ChildLoginCode {
  id        String   @id @default(cuid())
  accountId String
  account   User     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  codeHash  String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([accountId])
}

// Un enfant (compte enfant) demande à échanger ses étoiles contre une
// récompense ; un adulte accepte (l'échange est alors enregistré) ou refuse.
model RewardRequest {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberId  String
  member    FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  rewardId  String?
  reward    Reward?      @relation(fields: [rewardId], references: [id], onDelete: SetNull)
  title     String
  cost      Int
  // "pending" | "accepted" | "declined"
  status    String       @default("pending")
  // Petit mot du parent en cas de refus.
  note      String       @default("")
  createdAt DateTime     @default(now())
  decidedAt DateTime?

  @@index([userId, status])
}

// Argent de poche d'un enfant (compte enfant) : une règle (montant, chaque
// semaine ou chaque mois) et les versements reçus, automatiques ou ponctuels.
// Les versements automatiques sont créés à la lecture (pas de tâche programmée).
model PocketMoneyRule {
  id          String   @id @default(cuid())
  accountId   String   @unique
  account     User     @relation("PocketMoneyRule", fields: [accountId], references: [id], onDelete: Cascade)
  amountCents Int
  // "weekly" | "monthly"
  frequency   String
  // weekly : 0 = lundi … 6 = dimanche ; monthly : jour du mois 1 à 28.
  day         Int
  // Premier jour possible d'un versement, « AAAA-MM-JJ ».
  startDay    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PocketMoneyCredit {
  id          String   @id @default(cuid())
  accountId   String
  account     User     @relation("PocketMoneyCredits", fields: [accountId], references: [id], onDelete: Cascade)
  amountCents Int
  label       String
  // « AAAA-MM-JJ » (heure de Paris)
  day         String
  // "auto" (règle) | "manual" (ajouté par un parent) | "repay" (négatif : remboursement d'une avance)
  source      String
  createdAt   DateTime @default(now())

  @@index([accountId, day])
}

// Argent avancé à un enfant (un jeu, une sortie…) : il le rembourse quand il
// veut depuis sa cagnotte ; chaque remboursement est un versement négatif
// (source « repay ») et fait monter repaidCents.
model PocketMoneyAdvance {
  id          String   @id @default(cuid())
  accountId   String
  account     User     @relation("PocketMoneyAdvances", fields: [accountId], references: [id], onDelete: Cascade)
  amountCents Int
  label       String
  // « AAAA-MM-JJ » (heure de Paris)
  day         String
  repaidCents Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([accountId])
}

// « Aide aux devoirs » : a photographed exercise, read by Cervelle into
// questions. `questions` is [{ prompt, hints[3], solution, hintsShown,
// attempts, solved, lastMessage }]; the solution never leaves the server.
model HomeworkHelp {
  id           String   @id @default(cuid())
  learnerId    String
  learner      Learner  @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  subject      String   @default("")
  instructions String   @default("")
  questions    Json
  createdAt    DateTime @default(now())

  @@index([learnerId, createdAt])
}

// Mode Brevet : a mock paper for one subject (francais | maths | histoire |
// sciences). `exercises` is [{ title, points, documents, questions: [{ prompt,
// points, correction, advice }] }].
model BrevetSubject {
  id        String   @id @default(cuid())
  learnerId String
  learner   Learner  @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  subject   String
  // "processing" | "ready" | "failed"
  status    String   @default("processing")
  error     String?
  title     String   @default("")
  minutes   Int      @default(0)
  exercises Json
  createdAt DateTime @default(now())

  @@index([learnerId, createdAt])
}

// ─── Comptes partagés (« Comptes ») ──────────────────────────────────────
// A group of people who share expenses (« Enfants avec Marc », « Vacances »).
// Owned by the family; its participants are family members or outsiders known
// by their name only. Amounts in cents. See lib/splits.ts.
model SplitGroup {
  id           String             @id @default(cuid())
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  emoji        String             @default("💸")
  // Split remembered for new expenses: { mode, values: { participantId: value } }.
  defaultSplit Json?
  archivedAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  participants SplitParticipant[]
  expenses     SplitExpense[]

  @@index([userId])
}

model SplitParticipant {
  id        String         @id @default(cuid())
  groupId   String
  group     SplitGroup     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name      String
  // Set when the participant is a member of the family.
  memberId  String?
  member    FamilyMember?  @relation(fields: [memberId], references: [id], onDelete: SetNull)
  order     Int            @default(0)
  // Secret of this person\'s web link (« Partager le lien ») ; null = no link.
  linkToken String?        @unique
  createdAt DateTime       @default(now())
  paid      SplitExpense[] @relation("SplitPaidBy")
  shares    SplitShare[]

  @@index([groupId])
}

model SplitExpense {
  id          String           @id @default(cuid())
  groupId     String
  group       SplitGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  title       String
  amountCents Int
  paidById    String
  paidBy      SplitParticipant @relation("SplitPaidBy", fields: [paidById], references: [id], onDelete: Cascade)
  date        DateTime         @db.Date
  // "equal" | "percent" | "amount" | "shares"
  mode        String           @default("equal")
  // "expense", or "transfer" when someone pays someone back.
  kind        String           @default("expense")
  photoKey    String?
  photoMime   String?
  // Participant who added it through their web link (null: added in the app).
  addedById   String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  shares      SplitShare[]

  @@index([groupId, date])
}

model SplitShare {
  expenseId     String
  expense       SplitExpense     @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  participantId String
  participant   SplitParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  // What was entered (percent ×100, cents, number of shares, or 1).
  value         Int
  amountCents   Int

  @@id([expenseId, participantId])
}
